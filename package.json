      "view/title": [
        {
          "command": "betterSqlTools.newConnection",
          "when": "view == betterSqlTools.connections",
          "group": "navigation@1"
        },
        {
          "command": "betterSqlTools.newGroup",
          "when": "view == betterSqlTools.connections",
          "group": "navigation@2"
        },
        {
          "command": "betterSqlTools.filterObjects",
          "when": "view == betterSqlTools.connections && !betterSqlTools.filterActive",
          "group": "navigation@3"
        },
        {
          "command": "betterSqlTools.clearFilter",
          "when": "view == betterSqlTools.connections && betterSqlTools.filterActive",
          "group": "navigation@3"
        },
        {
          "command": "betterSqlTools.refresh",
          "when": "view == betterSqlTools.connections",
          "group": "navigation@4"
        },
        {
          "command": "betterSqlTools.showHistory",
          "when": "view == betterSqlTools.connections",
          "group": "navigation@5"
        },
        {
          "command": "betterSqlTools.searchObjects",
          "when": "view == betterSqlTools.connections",
          "group": "0_find@1"
        },
        {
          "command": "betterSqlTools.openProjectConfig",
          "when": "view == betterSqlTools.connections",
          "group": "9_project@1"
        },
        {
          "command": "betterSqlTools.createProjectConfig",
          "when": "view == betterSqlTools.connections",
          "group": "9_project@2"
        },
        {
