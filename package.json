    "keybindings": [
      {
        "command": "betterSqlTools.runStatement",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == sql"
      },
      {
        "command": "betterSqlTools.runFile",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "editorTextFocus && editorLangId == sql"
      }
    ],
    "configuration": {
      "title": "Better SQLTools",
      "properties": {
        "betterSqlTools.connections": {
          "type": "array",
          "default": [],
          "scope": "window",
          "markdownDescription": "Saved connections. Passwords are **not** kept here; they live in VS Code's secret storage. Use the *New Connection* form rather than editing by hand.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "driver"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "description": "Stable identifier. Generated for you; set it yourself when writing profiles by hand."
              },
              "name": {
                "type": "string",
                "description": "Name shown in the Connections view."
              },
              "driver": {
                "type": "string",
                "description": "Driver id, for example \"sqlite\"."
              },
              "group": {
                "type": "string",
                "description": "The group (project) the connection is listed under, by id. See betterSqlTools.groups."
              },
              "options": {
                "type": "object",
                "additionalProperties": true,
                "markdownDescription": "Driver options. `${workspaceFolder}`, `${userHome}` and `${env:NAME}` are expanded."
              }
            }
          }
        },
        "betterSqlTools.groups": {
          "type": "array",
          "default": [],
          "scope": "window",
          "markdownDescription": "Groups (projects) that connections are filed under, like `personal` or `arom-backend`. Use *New Group* in the view rather than editing by hand. A project can also define groups, connections and settings in `.better-sqltools.toml`.",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "description": "What a connection's `group` refers to."
              },
              "name": {
                "type": "string",
                "description": "Name shown in the Connections view. Defaults to the id."
              },
              "description": {
                "type": "string"
              },
              "icon": {
                "type": "string",
                "description": "A codicon id, for example \"server\"."
              },
              "color": {
                "type": "string",
                "description": "A theme colour id, for example \"charts.blue\"."
              }
            }
          }
        },
        "betterSqlTools.explorer.driverIcons": {
          "type": "boolean",
          "default": true,
          "description": "Show each driver's own icon next to its connections, instead of a generic database icon. A connected connection is shown in green either way."
        },
        "betterSqlTools.explorer.showDriverName": {
          "type": "boolean",
          "default": true,
          "description": "Show the driver's name after the connection's name, for example SQLite."
        },
        "betterSqlTools.explorer.showCounts": {
          "type": "boolean",
          "default": true,
          "description": "Show how many tables, views, indexes and so on each folder holds."
        },
        "betterSqlTools.explorer.showRowCounts": {
          "type": "boolean",
          "default": false,
          "description": "Show how many rows each table has. Counting rows can be slow on big tables, so this is off by default."
        },
        "betterSqlTools.results.maxRows": {
          "type": "number",
          "default": 1000,
          "minimum": 1,
          "maximum": 1000000,
          "markdownDescription": "Rows loaded per statement. Drivers stop reading after this many."
        },
        "betterSqlTools.results.columnFit": {
          "type": "string",
          "enum": [
            "fitAll",
            "fitName",
            "fitNameAndValue"
          ],
          "default": "fitNameAndValue",
          "enumDescriptions": [
            "Every column gets the same share of the panel, whatever its name or values are.",
            "Each column is as wide as its name (and type).",
            "Each column fits its name and its values, but a single very long value cannot make it wider than a sensible maximum."
          ],
          "markdownDescription": "How wide the results grid makes its columns. You can still drag a column's border to size it by hand, and double-click the border to fit that one column to its name and values."
        },
        "betterSqlTools.results.showTypes": {
          "type": "boolean",
          "default": true,
          "description": "Show each column's data type next to its name in the results grid."
        },
        "betterSqlTools.results.colorByType": {
          "type": "boolean",
          "default": true,
          "description": "Colour and style the results grid by data type and constraints: numbers, text, booleans, dates and NULLs look different, and primary and foreign keys stand out."
        },
        "betterSqlTools.results.editMode": {
          "type": "string",
          "enum": [
            "autoCommit",
            "manual"
          ],
          "default": "autoCommit",
          "enumDescriptions": [
            "Each edit in the results grid is saved as soon as you finish it.",
            "Edits wait in a transaction until you press Commit, or Roll back to undo them all."
          ],
          "markdownDescription": "How edits made in the results grid are saved. `manual` needs a driver that supports transactions; with any other driver each edit is saved at once. A project's `.better-sqltools.toml` can set this too."
        },
        "betterSqlTools.connection.timeoutMs": {
          "type": "number",
          "default": 30000,
          "minimum": 0,
          "markdownDescription": "How long to wait for a connection to open, in milliseconds. `0` waits forever."
        },
        "betterSqlTools.history.maxEntries": {
          "type": "number",
          "default": 200,
          "minimum": 0,
          "maximum": 5000,
          "description": "Queries kept in the history."
        },
        "betterSqlTools.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show Run above each statement and the active connection on the first line."
        },
        "betterSqlTools.completion.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Offer tables, columns and keywords from the editor's connection."
        },
        "betterSqlTools.lint.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Lint SQL files with [sqlfluff](https://sqlfluff.com). Needs sqlfluff installed (`pip install sqlfluff`)."
        },
        "betterSqlTools.lint.run": {
          "type": "string",
          "enum": [
            "onSave",
            "onType",
            "manual"
          ],
          "default": "onSave",
          "enumDescriptions": [
            "When a file opens and when it is saved",
            "Also while typing",
            "Only with the Lint command"
          ],
          "description": "When to lint."
        },
        "betterSqlTools.lint.severity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "hint"
          ],
          "default": "warning",
          "description": "How style issues are shown. Parse errors are always errors."
        },
        "betterSqlTools.lint.defaultDialect": {
          "type": "string",
          "default": "ansi",
          "markdownDescription": "sqlfluff dialect for editors without a connection, such as `postgres` or `tsql`. With a connection, its driver's dialect is used."
        },
        "betterSqlTools.lint.sqlfluffPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path to the `sqlfluff` executable. Empty uses `sqlfluff` from your PATH."
        },
        "betterSqlTools.lint.sqlfluffArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine-overridable",
          "markdownDescription": "Extra arguments for sqlfluff, such as `[\"--config\", \"/path/.sqlfluff\"]`. They come after ours and win."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts drivers/*/test/*.test.ts",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "npm run typecheck && vsce package --no-dependencies",
    "package:sqlite": "npm run typecheck && node esbuild.mjs --production && cd drivers/sqlite && vsce package --no-dependencies",
    "icons": "node scripts/make-icons.mjs",
    "seed:demo": "node scripts/seed-demo.mjs"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20.19.43",
    "@types/sql.js": "^1.4.11",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.0",
    "smol-toml": "^1.9.1",
    "sql.js": "^1.15.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
