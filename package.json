          "group": "2_manage@4"
        },
        {
          "command": "betterSqlTools.renameGroup",
          "when": "view == betterSqlTools.connections && viewItem =~ /^group\\.(user|workspace|implicit)$/",
          "group": "1_group@1"
        },
        {
          "command": "betterSqlTools.inspectConnection",
          "when": "view == betterSqlTools.connections && viewItem == connection.connected",
