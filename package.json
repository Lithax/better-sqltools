      },
      {
        "command": "betterSqlTools.bookmarks.run",
        "title": "Run",
        "category": "Better SQLTools",
        "icon": "$(play)"
      },
      {
        "command": "betterSqlTools.bookmarks.copy",
        "title": "Copy SQL",
        "category": "Better SQLTools",
        "icon": "$(copy)"
      },
      {
        "command": "betterSqlTools.bookmarks.rename",
        "title": "Rename Bookmark…",
        "category": "Better SQLTools",
        "icon": "$(edit)"
      },
      {
        "command": "betterSqlTools.bookmarks.delete",
        "title": "Delete Bookmark",
        "category": "Better SQLTools",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "betterSqlTools.editConnection",
          "when": "false"
        },
        {
          "command": "betterSqlTools.duplicateConnection",
          "when": "false"
        },
        {
          "command": "betterSqlTools.deleteConnection",
          "when": "false"
        },
        {
          "command": "betterSqlTools.renameGroup",
          "when": "false"
        },
        {
          "command": "betterSqlTools.deleteGroup",
          "when": "false"
        },
        {
          "command": "betterSqlTools.moveToGroup",
          "when": "false"
        },
        {
          "command": "betterSqlTools.showTableData",
          "when": "false"
        },
        {
          "command": "betterSqlTools.generateSelect",
          "when": "false"
        },
        {
          "command": "betterSqlTools.showDDL",
          "when": "false"
        },
        {
          "command": "betterSqlTools.copyName",
          "when": "false"
        },
        {
          "command": "betterSqlTools.runStatement",
          "when": "editorLangId == sql"
        },
        {
          "command": "betterSqlTools.runFile",
          "when": "editorLangId == sql"
        },
        {
          "command": "betterSqlTools.selectConnection",
          "when": "editorLangId == sql"
        },
        {
          "command": "betterSqlTools.lintNow",
          "when": "editorLangId == sql"
        },
        {
          "command": "betterSqlTools.fixDocument",
          "when": "editorLangId == sql"
        },
        {
          "command": "betterSqlTools.history.open",
          "when": "false"
        },
        {
          "command": "betterSqlTools.history.run",
          "when": "false"
        },
        {
          "command": "betterSqlTools.history.copy",
          "when": "false"
        },
        {
          "command": "betterSqlTools.history.bookmark",
          "when": "false"
        },
        {
          "command": "betterSqlTools.history.delete",
          "when": "false"
        },
        {
          "command": "betterSqlTools.bookmarks.open",
          "when": "false"
        },
        {
          "command": "betterSqlTools.bookmarks.run",
          "when": "false"
        },
        {
          "command": "betterSqlTools.bookmarks.copy",
          "when": "false"
        },
