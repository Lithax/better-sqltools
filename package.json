          "group": "9_project@3"
        },
        {
          "command": "betterSqlTools.findDrivers",
          "when": "view == betterSqlTools.drivers",
          "group": "navigation"
        },
        {
          "command": "betterSqlTools.history.filter",
          "when": "view == betterSqlTools.history && !betterSqlTools.historyFilterActive",
          "group": "navigation@1"
        },
        {
          "command": "betterSqlTools.history.clearFilter",
          "when": "view == betterSqlTools.history && betterSqlTools.historyFilterActive",
          "group": "navigation@1"
        },
        {
          "command": "betterSqlTools.clearHistory",
          "when": "view == betterSqlTools.history",
          "group": "9_manage@1"
        },
        {
          "command": "betterSqlTools.bookmarkQuery",
          "when": "view == betterSqlTools.bookmarks",
          "group": "navigation@1"
        },
        {
          "command": "betterSqlTools.runBookmark",
          "when": "view == betterSqlTools.bookmarks",
          "group": "1_run@1"
        }
      ],
      "view/item/context": [
        {
          "command": "betterSqlTools.connect",
          "when": "view == betterSqlTools.connections && viewItem =~ /^connection\\.(disconnected|error)$/",
          "group": "inline@1"
        },
        {
          "command": "betterSqlTools.newQuery",
          "when": "view == betterSqlTools.connections && viewItem == connection.connected",
          "group": "inline@1"
        },
        {
          "command": "betterSqlTools.disconnect",
